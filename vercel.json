{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "dugudugu-chameleon.vercel.app" }],
      "destination": "https://dugupop.com/:path",
      "statusCode": 301
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.dugupop.com" }],
      "destination": "https://dugupop.com/:path",
      "statusCode": 301
    },
    {
      "source": "/ko/games/:slug/",
      "destination": "/:slug/",
      "statusCode": 301
    },
    {
      "source": "/ko/games/:slug",
      "destination": "/:slug/",
      "statusCode": 301
    },
    {
      "source": "/en/games/:slug/",
      "destination": "/en/:slug/",
      "statusCode": 301
    },
    {
      "source": "/en/games/:slug",
      "destination": "/en/:slug/",
      "statusCode": 301
    },
    { "source": "/ko/", "destination": "/", "statusCode": 301 },
    { "source": "/ko", "destination": "/", "statusCode": 301 }
  ]
}
